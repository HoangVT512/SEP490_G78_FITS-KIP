<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/primary_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- QR Code Image -->
        <ImageView
            android:id="@+id/iv_equipment_qr"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="QR Code"
            android:src="@drawable/ic_qr_code"
            app:tint="@color/primary_color" />

        <!-- Equipment Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Equipment Code -->
            <TextView
                android:id="@+id/tv_equipment_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equipment_code_sample"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Equipment Name -->
            <TextView
                android:id="@+id/tv_equipment_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/equipment_name_sample"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <!-- Stage -->
            <TextView
                android:id="@+id/tv_equipment_stage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/stage_sample"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Line -->
            <TextView
                android:id="@+id/tv_equipment_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/line_sample"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Issues -->
            <TextView
                android:id="@+id/tv_equipment_issues"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/issues_sample"
                android:textColor="@color/error"
                android:textSize="14sp"
                android:textStyle="italic" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
